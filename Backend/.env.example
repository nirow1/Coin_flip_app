DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coin_flip_db?ssl=disable
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/coin_flip_test_db?ssl=disable
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
REDIS_URL=redis://localhost:6379/0

# Solana (required — no mainnet RPC default; testnet unsupported)
# Webhook: custom HMAC over "{unix_ts}.{raw_body}" with headers
#   x-webhook-signature (hex) + x-webhook-timestamp — not Helius's auth header / tx array.
SOLANA_WEBHOOK_SECRET=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_COLD_RECEIVE_ADDRESS=
SOLANA_HOT_WALLET_ADDRESS=
# Keypair JSON array from secret store; pubkey must match SOLANA_HOT_WALLET_ADDRESS.
# Required for payout/reconciler workers only — leave unset for API web processes.
SOLANA_HOT_WALLET_SECRET=
# Must match cluster mint (devnet Circle USDC below; mainnet-beta is EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
